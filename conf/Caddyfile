# OpenMausBot on Railway: Caddy is the only public listener, on $PORT behind
# Railway's edge. It follows upstream's documented proxy contract
# (docs/self-hosting.md, "Putting a proxy in front"):
#   - keep the browser's Host;
#   - set X-Forwarded-For and X-Forwarded-Proto, so every request through here
#     is remote and needs a paired session;
#   - do not buffer the event stream.
# The loopback ports must match scripts/run-omb.sh.

{
	admin off
	auto_https off
	persist_config off
	grace_period 10s
	servers {
		# Railway's edge reaches the container from a private address and
		# names the client in X-Real-IP. Anything else stays the peer address.
		trusted_proxies static private_ranges 100.64.0.0/10
		trusted_proxies_strict
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

:{$PORT} {
	encode zstd gzip
	header -Server

	# Webhook receiver: each hook carries its own secret, as in upstream's
	# Caddyfile, so it sits outside the login.
	handle /hooks/* {
		reverse_proxy 127.0.0.1:8800 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}

	# Everything else is OpenMausBot: web app, API, SSE and WebSockets.
	# /api/health answers without a session for Railway's health check.
	handle {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}
}
