#!/bin/sh
# `omb ...` over `railway ssh`: runs OpenMausBot's own CLI as the app user, so
# a root shell never leaves root-owned files on /data.
#   omb pair --label Laptop
#   omb sessions
#   omb devices revoke <id>
set -eu

if [ "${OMB_PUBLIC_URL:-}" = "https://" ] || [ "${OMB_PUBLIC_URL:-}" = "http://" ]; then
  unset OMB_PUBLIC_URL
fi
if [ -n "${OMB_PUBLIC_URL:-}" ]; then
  export OMB_PUBLIC_URL="${OMB_PUBLIC_URL%/}"
fi
if [ -z "${OMB_PUBLIC_URL:-}" ] && [ -n "${RAILWAY_PUBLIC_DOMAIN:-}" ]; then
  export OMB_PUBLIC_URL="https://${RAILWAY_PUBLIC_DOMAIN}"
fi

export HOME=/data
export OMB_DATA_DIR=/data/.openmausbot
export OMB_PORT=8799
unset PORT

if [ "$(id -u)" -eq 0 ]; then
  APP_UID="$(id -u maus)"
  APP_GID="$(id -g maus)"
  exec setpriv --reuid="$APP_UID" --regid="$APP_GID" --init-groups \
    node /app/dist-server/openmausbot.js "$@"
fi

exec node /app/dist-server/openmausbot.js "$@"
